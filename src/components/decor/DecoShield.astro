<!--
  HSEQ shield watermark — large faint shield with "HSEQ" text.
  Drop into any <section style="position:relative;overflow:hidden;">
-->
<div class="deco-shield" aria-hidden="true">
  <svg viewBox="0 0 200 240" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="shield-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--accent)"/>
        <stop offset="100%" stop-color="var(--accent-2)"/>
      </linearGradient>
    </defs>
    <!-- Shield body -->
    <path d="M100 10 L180 40 L180 110 Q180 170 100 220 Q20 170 20 110 L20 40Z"
          fill="none" stroke="url(#shield-grad)" stroke-width="6" opacity="0.5"/>
    <!-- Inner shield line -->
    <path d="M100 25 L165 50 L165 108 Q165 160 100 205 Q35 160 35 108 L35 50Z"
          fill="none" stroke="var(--accent-2)" stroke-width="3" opacity="0.3"/>
    <!-- HSEQ text -->
    <text x="100" y="125" text-anchor="middle"
          font-family="var(--font-display, 'Archivo Black')"
          font-size="36" font-weight="700" fill="var(--accent)" opacity="0.35">
      HSEQ
    </text>
    <!-- Checkmark -->
    <path d="M70 130 L90 150 L130 110"
          fill="none" stroke="var(--accent)" stroke-width="5"
          stroke-linecap="round" stroke-linejoin="round" opacity="0.3"/>
  </svg>
</div>

<style>
  .deco-shield {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    opacity: 0.6;
  }
  .deco-shield svg {
    width: 200px;
    height: 240px;
  }
</style>
