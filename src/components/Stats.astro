---
import DecoHazardStripes from "./decor/DecoHazardStripes.astro";
---

<section class="section" style="position:relative;overflow:hidden;">
  <DecoHazardStripes />
  <div class="container">
    <div class="stats-grid">
      <div class="stat-item reveal">
        <div class="stat-number num"><span class="counter" data-target="5">0</span><span class="suffix">+</span></div>
        <p class="stat-label">Años de experiencia liderando la prevención de riesgos y seguridad en trabajo</p>
      </div>
      <div class="stat-item reveal reveal-delay-1">
        <div class="stat-number num"><span class="counter" data-target="2">0</span><span class="suffix"></span></div>
        <p class="stat-label">Titulaciones técnicas (HSEQ + Enfermería)</p>
      </div>
      <div class="stat-item reveal reveal-delay-2">
        <div class="stat-number num"><span class="counter" data-target="3">0</span><span class="suffix"></span></div>
        <p class="stat-label">Sectores de ingeniería intervenidos (Civil, Metalmecánico y Vial)</p>
      </div>
    </div>
  </div>
</section>
