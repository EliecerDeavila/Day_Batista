---
const cursos = [
  {
    title: "Licencia en Seguridad y Salud en el Trabajo",
    description: "Aval legal para la ejecución y firma del SG-SST a nivel nacional.",
    meta: "Secretaría de Salud Departamental · Emitida y Vigente",
    icon: "shield"
  },
  {
    title: "Coordinador de Trabajo en Alturas",
    description: "Certificación obligatoria para la administración y emisión de permisos de alto riesgo.",
    meta: "Centro de Entrenamiento Autorizado · Vigente bajo Res. 4272",
    icon: "trending-up"
  },
  {
    title: "Servicio al Cliente (48h)",
    description: "Optimización de la comunicación, manejo de peticiones y habilidades de atención interinstitucional.",
    meta: "SENA (Reg. Bolívar) ",
    icon: "message-circle"
  },
  {
    title: "Mercadeo y Ventas - Nivel II (150h)",
    description: "Desarrollo de estrategias comerciales, análisis de necesidades y gestión de relaciones clave.",
    meta: "SENA (Reg. Bolívar) ",
    icon: "bar-chart"
  },
  {
    title: "Contratación y Afiliación a Seguridad Social (48h)",
    description: "Gestión legal del entorno laboral, trámites de afiliación y normatividad del sistema de seguridad social.",
    meta: "SENA (Reg. Antioquia) ",
    icon: "file-text"
  },
  {
    title: "Actualización del Sistema de Gestión de la SST (20h)",
    description: "Capacitación obligatoria y periódica exigida por el Ministerio de Trabajo de Colombia.",
    meta: "SENA (Reg. Tolima) ",
    icon: "refresh-cw"
  },
  {
    title: "Administración de Recursos Humanos (40h)",
    description: "Dirección de personal, control de procesos administrativos y gestión del talento humano en frentes de trabajo.",
    meta: "SENA (Reg. Cesar) ",
    icon: "users"
  },
  {
    title: "Implementación del Sistema de Gestión de la SST (50h)",
    description: "Planeación, estructuración y despliegue del SG-SST bajo los estándares legales vigentes.",
    meta: "SENA (Reg. Bolívar) ",
    icon: "clipboard"
  },
  {
    title: "Avanzado Trabajo Seguro en Alturas (40h)",
    description: "Prevención de riesgos críticos, control operativo y aseguramiento técnico en tareas de alto riesgo.",
    meta: "SENA (Reg. Bolívar) ",
    icon: "target"
  },
  {
    title: "Salud Ocupacional (40h)",
    description: "Fundamentos de la higiene industrial, seguridad en el trabajo y medicina preventiva en campo.",
    meta: "SENA (Reg. Bolívar) ",
    icon: "heart"
  }
];
const iconPaths = {
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  "trending-up": '<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>',
  "message-circle": '<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>',
  "bar-chart": '<line x1="12" y1="20" x2="12" y2="10"/><line x1="18" y1="20" x2="18" y2="4"/><line x1="6" y1="20" x2="6" y2="16"/>',
  "file-text": '<path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>',
  "refresh-cw": '<polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M3.51 9a9 9 0 0114.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0020.49 15"/>',
  users: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>',
  clipboard: '<path d="M16 4h2a2 2 0 012 2v14a2 2 0 01-2 2H6a2 2 0 01-2-2V6a2 2 0 012-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>',
  target: '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  heart: '<path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>'
};
const badgeGradients = {
  shield: "linear-gradient(145deg, var(--accent), var(--accent-2))",
  "trending-up": "linear-gradient(145deg, var(--warning), var(--accent))",
  "message-circle": "linear-gradient(145deg, var(--accent-2-soft), var(--accent-soft))",
  "bar-chart": "linear-gradient(145deg, var(--warning), var(--accent-2))",
  "file-text": "linear-gradient(145deg, var(--accent), var(--accent-soft))",
  "refresh-cw": "linear-gradient(145deg, var(--accent-2), var(--accent))",
  users: "linear-gradient(145deg, var(--accent-soft), var(--accent-2-soft))",
  clipboard: "linear-gradient(145deg, var(--accent), var(--warning))",
  target: "linear-gradient(145deg, var(--warning), var(--accent-2-soft))",
  heart: "linear-gradient(145deg, var(--accent-2), var(--accent-soft))"
};
const badgeColors = {
  shield: "var(--surface)",
  "trending-up": "var(--surface)",
  "message-circle": "var(--accent)",
  "bar-chart": "var(--surface)",
  "file-text": "var(--surface)",
  "refresh-cw": "var(--surface)",
  users: "var(--accent-2)",
  clipboard: "var(--surface)",
  target: "var(--surface)",
  heart: "var(--surface)"
};
const delays = ["", "reveal-delay-1", "reveal-delay-2", "reveal-delay-3"];
---
<section class="section">
  <div class="container">
    <div class="section-header reveal">
      <p class="eyebrow">Formación Continua</p>
      <h2 class="h2">Certificaciones y Cursos</h2>
      <p>Licencias y avales vigentes que habilitan mi control operacional en campo.</p>
    </div>
    <div class="grid-2 cascade" id="cursosGrid">
      {cursos.map((curso, i) => (
        <div class={`curso-card reveal ${delays[i % delays.length]}`}>
          <div class="badge-3d">
            <div class="badge-face" style={`background:${badgeGradients[curso.icon]};color:${badgeColors[curso.icon]}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[curso.icon]} />
            </div>
          </div>
          <div class="curso-info">
            <h3>{curso.title}</h3>
            <p>{curso.description}</p>
            <span class="meta">{curso.meta}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
